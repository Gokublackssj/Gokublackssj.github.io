---
import "@fontsource-variable/source-serif-4/wght.css";
import "@fontsource-variable/source-serif-4/wght-italic.css";
import "@fontsource-variable/public-sans/wght.css";
import "../styles/global.css";

import { getImage } from "astro:assets";
import { dicts, paths, type Lang } from "../i18n";
import ogSource from "../assets/shots/quoteflow/correction-highlighted.png";
// The latin fonts the first screen uses (the headline is set in both the
// upright and the italic serif), preloaded so the hero text does not reflow
// (and shift) when they arrive.
import displayFont from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import displayItalicFont from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-italic.woff2?url";
import textFont from "@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { lang, noindex = false } = Astro.props;
const t = dicts[lang];
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const og = await getImage({ src: ogSource, width: 1200, height: 630, fit: "cover", position: "top", format: "png" });
const ogUrl = new URL(og.src, site).href;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Luis Alvaro Pimentel Tacuri",
  jobTitle: lang === "es" ? "Desarrollador Python junior" : "Junior Python developer",
  address: { "@type": "PostalAddress", addressLocality: "Potosí", addressCountry: "BO" },
  url: new URL(paths[lang], site).href,
  sameAs: ["https://github.com/Gokublackssj"],
  knowsLanguage: ["es", "en"],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <!-- Both values match --canvas in global.css; the inline script below keeps
         the one in use when the visitor has chosen a theme. -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16181b" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayItalicFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    {
      !noindex &&
        (Object.keys(paths) as Lang[]).map((l) => (
          <link rel="alternate" hreflang={l} href={new URL(paths[l], site).href} />
        ))
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(paths.en, site).href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      // Motion setting before the first paint: the visitor's choice from the
      // footer (localStorage, key shared with src/scripts/motion-preference.ts),
      // or else their prefers-reduced-motion setting. The CSS reads data-motion.
      (function () {
        var m;
        try {
          m = localStorage.getItem("luisdataworks:motion");
        } catch (e) {}
        if (m !== "on" && m !== "off") {
          m = window.matchMedia("(prefers-reduced-motion: no-preference)").matches ? "on" : "off";
        }
        document.documentElement.setAttribute("data-motion", m);
        // The hero's entrance plays on this first paint only (global.css reads
        // .intro). Turning animations on later never replays it: the class is
        // removed after the entrance and on any change of the setting.
        if (m === "on") document.documentElement.classList.add("intro");
      })();
      // Theme before the first paint, the same way: the visitor's choice from
      // the header switch (localStorage, key shared with src/scripts/theme.ts),
      // or else their prefers-color-scheme. The CSS reads data-theme, so the
      // page never flashes the other theme on load or between languages.
      (function () {
        var t;
        try {
          t = localStorage.getItem("luisdataworks:theme");
        } catch (e) {}
        var chosen = t === "light" || t === "dark";
        if (!chosen) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", t);
        // A chosen theme overrides the system one in the browser's own chrome too.
        if (chosen) {
          document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
            m.setAttribute("content", t === "dark" ? "#16181b" : "#ffffff");
            m.removeAttribute("media");
          });
        }
      })();
      // Hides content for the entrance animation. If the page script never runs,
      // the class is removed again so nothing stays hidden.
      document.documentElement.classList.add("js");
      setTimeout(function () {
        if (!window.__revealReady) document.documentElement.classList.remove("js");
      }, 2500);
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skip}</a>
    <slot />
  </body>
</html>
