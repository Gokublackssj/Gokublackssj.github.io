---
import { getImage } from "astro:assets";
import type { PublishedDemo } from "../data/demos";
import Gallery from "./Gallery.astro";
import { dicts, paths, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  demo: PublishedDemo;
}

// Screenshots share the compact gallery. Optional recordings remain on request.
const { lang, demo } = Astro.props;
const t = dicts[lang];
const d = t.demos;
const pkg = t.services.packages.items[demo.package].name;
const copy = demo.copy[lang];
const views = ["desktop", "mobile"] as const;
const recorded = views.every((v) => demo.media[v].webm && demo.media[v].mp4);
const posters = Object.fromEntries(
  await Promise.all(
    views.map(async (v) => [v, (await getImage({ src: demo.media[v].poster, width: Math.min(1280, demo.media[v].poster.width), format: "webp", quality: 80 })).src]),
  ),
) as Record<(typeof views)[number], string>;
---

<article class="demo-card" aria-labelledby={`demo-${demo.id}`}>
  <div>
    <Gallery lang={lang} group={`demo-${demo.id}`} title={copy.name} desktop={[{id:"desktop",src:demo.media.desktop.poster}]} mobile={[{id:"mobile",src:demo.media.mobile.poster}]} captions={{desktop:[d.desktop,copy.alt],mobile:[d.mobile,copy.alt]}} />
    {recorded&&<details class="demo-recordings"><summary>{lang==="es"?"Grabaciones del sitio":"Site recordings"}</summary>{views.map(view=><video controls playsinline preload="none" poster={posters[view]} aria-label={`${copy.name} · ${view}`}><source src={demo.media[view].webm} type="video/webm"/><source src={demo.media[view].mp4} type="video/mp4"/></video>)}</details>}
  </div>
  <div class="demo-body">
    <p class="demo-package">{pkg}</p>
    <h5 id={`demo-${demo.id}`} class="display">{copy.name}</h5>
    <p class="demo-business">{d.business[demo.package]}</p>
    <p class="demo-concept">{d.concept}</p>
    <div>
      <h6>{d.goal}</h6>
      <p>{copy.goal}</p>
    </div>
    <div>
      <h6>{d.features}</h6>
      <ul class="check-list">{copy.features.map((f) => <li>{f}</li>)}</ul>
    </div>
    <div class="site-actions">
      <a class="lg lg--frost interior-button" data-lg-press href={demo.url} target="_blank" rel="noopener">
        {d.open}<span class="visually-hidden"> {t.a11y.newTab}</span>
      </a>
      <a class="lg lg--frost interior-button" data-lg-press href={`${paths[lang]}?plan=${demo.package}#contact`} data-plan={demo.package}>
        {t.services.packages.cta}<span class="visually-hidden">: {pkg}</span>
      </a>
    </div>
  </div>
</article>
