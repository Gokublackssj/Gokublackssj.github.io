---
import { dicts, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dicts[lang];
const a = t.about;
// The tools (formerly the Stack section), each with the projects that use it,
// written out instead of the old QF/LF/BDE abbreviations.
const names: Record<string, string> = { QF: "QuoteFlow", LF: "LeadFlow", BDE: "Book Data Extractor Pro" };
const where = (tags: string) => tags.split(" · ").map((tag) => names[tag] ?? tag).join(", ");
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="container about-grid">
    <!-- The letter: the page's one peach card. -->
    <div class="about-letter" data-reveal>
      <h2 id="about-title" class="display">{a.heading}</h2>
      <div class="about-text">
        {a.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="about-actions">
        <a class="button button--on-peach" href={`${lang === "es" ? "/es/" : "/"}#contact`}>{a.cta}</a>
        <a class="text-link" href={`${lang === "es" ? "/es/" : "/"}#contact`}>
          {lang === "es" ? "Ver CV y vías de contacto" : "View CV & contact options"}
        </a>
      </div>
      <div class="about-opportunities">
        <h3>{a.opportunityHeading}</h3>
        <p>{a.opportunityText}</p>
        <a class="text-link" href={`${lang === "es" ? "/es/" : "/"}?plan=opportunity#contact`} data-plan="opportunity">{a.opportunityCta}</a>
      </div>
    </div>

    <!-- The tools these projects really use, and where to see each one. -->
    <section class="tools" aria-labelledby="tools-title">
      <h3 id="tools-title" class="display" data-reveal>{t.stack.heading}</h3>
      <p class="tools-text" data-reveal>{t.stack.text}</p>
      <dl class="tools-list">
        {
          t.stack.groups.map((g) => (
            <div data-reveal>
              <dt>{g.name}</dt>
              <dd>
                <ul>
                  {g.items.map(([name, tags]) => (
                    <li>
                      <span class="tool-name">{name}</span>
                      <span class="tool-where">{where(tags)}</span>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</section>
