---
import { dicts, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const t = dicts[Astro.props.lang];
const [first, second] = t.hero.lines;
---

<section class="hero" aria-labelledby="hero-title">
  <!-- The offer first (what a client gets), then what I build and who I am,
       then the two actions: contact, and the projects, which come next. -->
  <div class="container hero-intro">
    <h1 id="hero-title" class="hero-title display">
      <span class="line"><span class="line-inner">{first}</span></span>
      <span class="line"><em class="line-inner">{second}</em></span>
    </h1>
    <p class="hero-lead">{t.hero.lead}</p>
    <p class="hero-availability">{t.hero.availability}</p>
    <div class="hero-actions">
      <a class="button" href="#contact">{t.hero.primary}</a>
      <a class="button button--ghost" href="#projects">{t.hero.secondary}</a>
    </div>
    <p class="hero-proof">{t.hero.proof}</p>
  </div>
</section>
