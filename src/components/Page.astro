---
import Layout from "../portfolio/InteriorLayout.astro";
import {dicts,type Lang} from "../i18n";
import {labProjects} from "../portfolio/projects";
interface Props {lang:Lang}
const {lang}=Astro.props,t=dicts[lang],es=lang==="es";
const software=labProjects(lang)[1]!.projects;
---
<Layout lang={lang} title={es ? "Automatización y software" : "Automation & Software"} description={t.families.software.text}>
  <header class="interior-intro" id="projects">
    <p class="interior-eyebrow">{es ? "Proyectos personales · Código público" : "Personal projects · Public code"}</p>
    <h1 id="projects-title">{es ? "Automatización" : "Automation"}<br /><em>{es ? "y software." : "& software."}</em></h1>
    <p id="python">{t.families.software.text}</p><span id="python-title"></span>
  </header>
  <ol class="project-rows" aria-label={t.families.software.heading}>
    {software.map((project,i)=><li id={project.id} class="project-tile lg-rim lg--frost">
      <span class="project-number" aria-hidden="true">0{i+1}</span>
      <div><h2 id={`${project.id}-title`}><a href={project.href}>{project.name}</a></h2><p>{project.description}</p><p class="project-state">{es?"Proyecto personal · Código público · Ejecución local":"Personal project · Public code · Runs locally"}</p></div>
      <a class="lg lg--clear lg-round project-explore" data-lg data-lg-depth="5" data-lg-bezel="9" href={project.href} data-lg-press aria-label={`${es?"Explorar":"Explore"} ${project.name}`}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
    </li>)}
  </ol>

</Layout>
