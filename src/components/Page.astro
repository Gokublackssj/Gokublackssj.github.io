---
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import CaseStudy from "./CaseStudy.astro";
import WebProjects from "./WebProjects.astro";
import RunSteps from "./RunSteps.astro";
import { websites, pythonProjects } from "../data/projects";
import { demos, isPublished } from "../data/demos";
import { runCommands, testCommands } from "../data/commands";
import Lightbox from "./Lightbox.astro";
import Services from "./Services.astro";
import Process from "./Process.astro";
import Faq from "./Faq.astro";
import About from "./About.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import { shots } from "../data/shots";
import videoPoster from "../assets/shots/leadflow/video-poster.png";
import { repos } from "../data/links";
import { dicts, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dicts[lang];
const b = t.bookExtractor;
const ix = t.projectsIntro.index;
const categories = [
  {
    id: "web",
    name: t.families.websites.heading,
    text: t.families.websites.index,
    count: ix.web(websites.length, demos.filter(isPublished).length, demos.filter((d) => !isPublished(d)).length),
  },
  { id: "python", name: t.families.software.heading, text: t.families.software.index, count: ix.python(pythonProjects.length) },
];
---

<Base lang={lang}>
  <Header lang={lang} />

  <main id="main">
    <Hero lang={lang} />

    <section class="section" id="projects" aria-labelledby="projects-title">
      <div class="container">
        <div class="section-head">
          <h2 id="projects-title" class="display" data-reveal>{t.projectsIntro.heading}</h2>
          <p data-reveal>{t.projectsIntro.text}</p>
        </div>

        <!-- The two categories, side by side: what each holds and how many,
             counted from src/data. Each link leads to its category below. -->
        <nav class="project-index" aria-label={t.projectsIntro.index.label}>
          {
            categories.map((c) => (
              <a class="project-index-link" href={`#${c.id}`} data-reveal>
                <span class="project-index-name display">{c.name}</span>
                <span class="project-index-text">{c.text}</span>
                <span class="project-index-count">{c.count}</span>
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <path d="M10 4v12M5 11l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            ))
          }
        </nav>

        <!-- Category 1: web development. Websites and the package demos. -->
        <WebProjects lang={lang} />

        <!-- Category 2: Python, data and automation, as case studies, in the
             order of pythonProjects (src/data/projects.ts). -->
        <section class="family" id="python" aria-labelledby="python-title">
          <div class="family-head">
            <h3 id="python-title" class="display" data-reveal>{t.families.software.heading}</h3>
            <p data-reveal>{t.families.software.text}</p>
          </div>

          <CaseStudy lang={lang} id="quoteflow" project={t.quoteflow} shots={shots.quoteflow} repo={repos.quoteflow} />
          <CaseStudy lang={lang} id="leadflow" project={t.leadflow} shots={shots.leadflow} repo={repos.leadflow} mirror video={{ base: "/media/leadflow-flow", poster: videoPoster }} />

          <!-- The same order as the other cases. It has no screenshots, so its
               picture is the real command that runs it. -->
          <article class="case case--compact" id="book-extractor" aria-labelledby="book-extractor-title">
            <header class="case-head">
              <h4 id="book-extractor-title" class="display" data-reveal>{b.name}</h4>
              <p class="case-kind" data-reveal>{b.kind}</p>
              <p class="case-useful" data-reveal><strong>{t.labels.usefulIf}</strong> {b.usefulIf}</p>
              <p class="case-status" data-reveal>{b.status}</p>
            </header>
            <div class="case-story">
              <div class="case-problem" data-reveal>
                <h5>{t.labels.problem}</h5>
                <p>{b.problem}</p>
              </div>
              <div class="case-solution" data-reveal>
                <h5>{t.labels.solution}</h5>
                <p>{b.summary}</p>
              </div>
            </div>
            <div class="case-visual">
              <figure class="case-run" data-reveal>
                <h5>{t.labels.run}</h5>
                <pre class="code" tabindex="0"><code>{runCommands.bookExtractor.slice(1).join("\n")}</code></pre>
              </figure>
              <div class="case-cando" data-reveal>
                <h5>{t.labels.canDo}</h5>
                <ul class="check-list">
                  {b.canDo.map((item) => <li>{item}</li>)}
                </ul>
                <a class="button button--ghost" href={repos.bookExtractor} target="_blank" rel="noopener">
                  {t.labels.repo}<span class="visually-hidden"> {t.a11y.newTab}</span>
                </a>
              </div>
            </div>
            <details class="case-details">
              <summary>
                <span class="case-details-title">{t.labels.details}</span>
                <span class="case-details-hint">{t.labels.detailsHint}</span>
                <svg class="case-details-chevron" aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <div class="case-details-body">
                <div class="case-block">
                  <h5>{t.labels.builtWith}</h5>
                  <p>{b.stack}</p>
                </div>
                <div class="case-block">
                  <h5>{t.labels.features}</h5>
                  <ul class="case-limits">{b.features.map((f) => <li>{f}</li>)}</ul>
                </div>
                <RunSteps lang={lang} id="bookExtractor" />
                <div class="case-block">
                  <h5>{t.labels.tests}</h5>
                  <pre class="code" tabindex="0"><code>{testCommands.bookExtractor}</code></pre>
                </div>
                <div class="case-block">
                  <h5>{t.labels.limits}</h5>
                  <p>{b.limits}</p>
                </div>
              </div>
            </details>
          </article>
        </section>
      </div>
    </section>

    <Services lang={lang} />
    <Process lang={lang} />
    <About lang={lang} />
    <Faq lang={lang} />
    <Contact lang={lang} />
  </main>

  <Footer lang={lang} />

  <Lightbox lang={lang} />
</Base>

<script>
  import "../scripts/reveal";
</script>
