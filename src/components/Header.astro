---
import { dicts, langNames, paths, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dicts[lang];
const languagePaths = Astro.url.pathname.includes("/projects/") ? {en:"/projects/",es:"/es/projects/"} : paths;
const home = paths[lang];
const links = [
  ["#projects", t.nav.projects],
  ["#services", t.nav.services],
  ["#about", t.nav.about],
  ["#contact", t.nav.contact],
] as const;
const langs = Object.keys(paths) as Lang[];
---

<header class="site-header" id="top">
  <div class="container header-inner">
    <a class="wordmark" href={home} aria-label={t.a11y.home}>luisdataworks</a>

    <nav class="nav-desktop" aria-label={t.a11y.mainNav}>
      {links.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>

    <div class="header-actions">
      <!-- Shown by src/scripts/theme.ts; without scripts the page follows the
           system theme. Pressed means the dark theme is on. -->
      <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label={t.a11y.themeDark} hidden>
        <svg class="icon-moon" aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
        </svg>
        <svg class="icon-sun" aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none">
          <circle cx="10" cy="10" r="3.4" stroke="currentColor" stroke-width="1.6" />
          <path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M4.3 15.7l1.4-1.4M14.3 5.7l1.4-1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
      <nav class="lang-switch" aria-label={t.a11y.langLabel}>
        {
          langs.map((l) => (
            <a
              href={languagePaths[l]}
              hreflang={l}
              lang={l}
              aria-current={l === lang ? "true" : undefined}
            >
              {l.toUpperCase()}<span class="visually-hidden"> ({langNames[l]})</span>
            </a>
          ))
        }
      </nav>
      <a class="button header-cta" href="#contact">{t.nav.cta}</a>
      <details class="menu">
        <summary>{t.a11y.menu}</summary>
        <div class="menu-panel">
          <nav aria-label={t.a11y.menu}>
            {links.map(([href, label]) => <a href={href}>{label}</a>)}
          </nav>
          <!-- On narrow phones the header has no room for the language switch,
               so it moves in here (a group: the header's nav is the landmark). -->
          <div class="lang-switch menu-lang" role="group" aria-label={t.a11y.langLabel}>
            {
              langs.map((l) => (
                <a href={languagePaths[l]} hreflang={l} lang={l} aria-current={l === lang ? "true" : undefined}>
                  {l.toUpperCase()}<span class="visually-hidden"> ({langNames[l]})</span>
                </a>
              ))
            }
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  import { initThemeToggle } from "../scripts/theme";

  initThemeToggle();

  // Close the phone menu after choosing a link or pressing Escape.
  const menu = document.querySelector<HTMLDetailsElement>(".menu");
  if (menu) {
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) menu.open = false;
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  }
</script>
