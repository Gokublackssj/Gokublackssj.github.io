---
import {Picture,getImage} from "astro:assets";
import type {Shot} from "../data/shots";
import {dicts,type Lang} from "../i18n";
interface Props {lang:Lang;group:string;title:string;desktop:Shot[];mobile:Shot[];captions:Record<string,string[]>;note?:string}
const {lang,group,title,desktop,mobile,captions,note}=Astro.props,t=dicts[lang];
const images=await Promise.all([...desktop,...mobile].map(async shot=>({...shot,full:(await getImage({src:shot.src,width:shot.src.width,format:"webp",quality:88})).src})));
---
<section class="gallery compact-gallery" data-compact-gallery aria-label={`${t.labels.gallery} · ${title}`}>
  <div class="gallery-heading"><h2>{t.labels.gallery}</h2><span>{lang==="es"?"Capturas reales del proyecto":"Real project screenshots"}</span></div>
  <div class="gallery-media">
  <div class="gallery-track" data-gallery-track tabindex="0" aria-label={lang==="es"?"Capturas: desliza o usa las flechas":"Screenshots: swipe or use arrow keys"}>
    {images.map((shot,i)=><figure class="gallery-slide" data-gallery-slide role="group" aria-label={`${i+1} / ${images.length}`}>
      <a class="shot" href={shot.full} data-gallery={group} data-title={title} data-caption={captions[shot.id]![0]} data-alt={captions[shot.id]![1]} aria-label={`${t.a11y.galleryOpen}: ${captions[shot.id]![1]}`}>
        <Picture src={shot.src} formats={["avif","webp"]} fallbackFormat="webp" widths={[390,640,960,1280].filter(w=>w<=shot.src.width)} sizes="(max-width: 700px) calc(100vw - 40px), 760px" alt={captions[shot.id]![1]!} loading="lazy" decoding="async" quality={82} />
      </a>
      <figcaption>{captions[shot.id]![0]}</figcaption>
    </figure>)}
  </div>
  <button class="gallery-expand lg lg--clear lg-round" type="button" data-gallery-expand data-lg data-lg-depth="5" data-lg-bezel="9" aria-label={t.a11y.galleryOpen} hidden><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5M3 3l6 6m12-6-6 6M3 21l6-6m12 6-6-6"/></svg></button>
  </div>
  <div class="gallery-controls" data-gallery-controls hidden>
    <button class="lg lg--clear lg-round" data-lg data-lg-depth="5" data-lg-bezel="9" type="button" data-gallery-prev aria-label={t.a11y.prev} data-lg-press><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m14 5-7 7 7 7"/></svg></button>
    <output data-gallery-position aria-live="polite" aria-atomic="true">1 / {images.length}</output>
    <button class="lg lg--clear lg-round" data-lg data-lg-depth="5" data-lg-bezel="9" type="button" data-gallery-next aria-label={t.a11y.next} data-lg-press><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m10 5 7 7-7 7"/></svg></button>
  </div>
  <p class="gallery-help">{lang==="es"?"Desliza para recorrer las capturas. Selecciona una imagen para ampliarla.":"Swipe through screenshots. Select an image to enlarge it."}</p>
  {note&&<p class="shots-note">{note}</p>}
</section>
<script>import {initCompactGalleries} from "../scripts/compact-gallery";initCompactGalleries();</script>
