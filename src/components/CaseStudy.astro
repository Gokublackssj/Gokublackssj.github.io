---
import { Picture, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Gallery from "./Gallery.astro";
import ZoomBadge from "./ZoomBadge.astro";
import type { ProjectShots } from "../data/shots";
import { dicts, type Dict, type Lang } from "../i18n";

type Project = Dict["quoteflow"] | Dict["leadflow"];

interface Props {
  lang: Lang;
  id: string;
  project: Project;
  shots: ProjectShots;
  repo: string;
  /** Mirrored composition, so neighbouring case studies do not share a layout. */
  mirror?: boolean;
  /** Optional screen recording: base path without extension, plus its poster frame. */
  video?: { base: string; poster: ImageMetadata };
}

const { lang, id, project: p, shots, repo, mirror = false, video } = Astro.props;
const t = dicts[lang];
const lead = shots.lead;
const leadFull = (await getImage({ src: lead.src, width: lead.src.width, format: "webp", quality: 88 })).src;
const captions = p.shots as Record<string, string[]>;
const [leadCaption, leadAlt] = captions[lead.id]!;
const note = "shotsNote" in p ? p.shotsNote : undefined;
const videoText = "video" in p ? p.video : undefined;
const poster = video ? (await getImage({ src: video.poster, width: 1280, format: "webp", quality: 80 })).src : undefined;

// Comments in the commands block are dimmed; everything else is code.
const commandLines = p.commands.split("\n");
---

<article class:list={["case", { "case--mirror": mirror }]} id={id} aria-labelledby={`${id}-title`}>
  <header class="case-head">
    <div class="case-title">
      <h3 id={`${id}-title`} class="display" data-reveal>{p.name}</h3>
      <p class="lead" data-reveal>{p.kind}</p>
    </div>
    <dl class="case-meta" data-reveal>
      <div>
        <dt>{t.labels.status}</dt>
        <dd>{p.status}</dd>
      </div>
      <div>
        <dt>{t.labels.repo}</dt>
        <dd>
          <a href={repo} target="_blank" rel="noopener">
            {repo.replace("https://", "")}<span class="visually-hidden"> {t.a11y.newTab}</span>
          </a>
        </dd>
      </div>
      <div>
        <dt>{t.labels.demo}</dt>
        <dd>{p.demo}</dd>
      </div>
      {
        p.license && (
          <div>
            <dt>{t.labels.license}</dt>
            <dd>{p.license}</dd>
          </div>
        )
      }
    </dl>
  </header>

  <figure class="case-lead-shot" data-reveal>
    <a
      class="shot"
      href={leadFull}
      data-gallery={id}
      data-title={p.name}
      data-caption={leadCaption}
      data-alt={leadAlt}
      aria-label={`${t.a11y.galleryOpen}: ${leadAlt}`}
    >
      <Picture
        src={lead.src}
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        widths={[640, 960, 1280, 1440]}
        sizes="(max-width: 1360px) 100vw, 1320px"
        alt={leadAlt!}
        loading="lazy"
        decoding="async"
        quality={82}
      />
      <ZoomBadge />
    </a>
    <figcaption class="small muted">{leadCaption}</figcaption>
  </figure>

  {
    video && videoText && (
      <figure class="case-video" data-reveal>
        <div class="video-frame">
          <video data-demo muted playsinline controls preload="none" poster={poster} width="1280" height="800" aria-label={videoText[1]}>
            <source src={`${video.base}.webm`} type="video/webm" />
            <source src={`${video.base}.mp4`} type="video/mp4" />
          </video>
          <!-- With scripts, this button starts the video; it plays only on request. -->
          <button class="video-play" type="button" hidden data-video-play>
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18"><path d="M4 2.5v13l11-6.5z" fill="currentColor" /></svg>
            {videoText[2]}
          </button>
        </div>
        <figcaption>
          <p class="video-title">{videoText[3]}</p>
          <p class="muted">{videoText[0]}</p>
        </figcaption>
      </figure>
    )
  }

  <div class="case-body">
    <div class="case-summary" data-reveal>
      <h4>{t.labels.whatItDoes}</h4>
      <p class="lead">{p.summary}</p>
    </div>
    <div class="case-features">
      <h4 class="visually-hidden">{t.labels.features}</h4>
      <ul class="feature-rows">
        {
          p.features.map(([title, text]) => (
            <li data-reveal>
              <strong>{title}</strong>
              <span>{text}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class:list={["decisions", { "decisions--dark": mirror }]}>
    <h4 data-reveal>{t.labels.decisions}</h4>
    <ul>
      {
        p.decisions.map(([claim, why]) => (
          <li data-reveal>
            <p>{claim}</p>
            <p>{why}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="tests">
    <div class="tests-side">
      <h4 data-reveal>{t.labels.tests}</h4>
      <p class="tests-note" data-reveal>{p.testsNote}</p>
      <pre class="code" tabindex="0" data-reveal><code>{commandLines.map((line, i) => (
        <Fragment>{line.startsWith("#") ? <span class="c">{line}</span> : line}{i < commandLines.length - 1 && "\n"}</Fragment>
      ))}</code></pre>
    </div>
    <div class="figure-row">
      {
        p.tests.map(([num, label, detail]) => (
          <div data-reveal>
            <p class="figure-num">{num}</p>
            <p class="figure-label">{label}</p>
            <p class="figure-detail small">{detail}</p>
          </div>
        ))
      }
    </div>
  </div>

  <Gallery lang={lang} group={id} title={p.name} desktop={shots.desktop} mobile={shots.mobile} captions={captions} note={note} />

  <div class="case-foot">
    <div class="case-limits" data-reveal>
      <h4>{t.labels.limits}</h4>
      <ul>{p.limits.map((l) => <li>{l}</li>)}</ul>
    </div>
    <div class="case-built" data-reveal>
      <h4>{t.labels.builtWith}</h4>
      <p>{p.stack}</p>
      <a class="button button--silver" href={repo} target="_blank" rel="noopener">
        {t.labels.repo} <span class="arrow" aria-hidden="true">↗</span><span class="visually-hidden"> {t.a11y.newTab}</span>
      </a>
    </div>
  </div>
</article>
