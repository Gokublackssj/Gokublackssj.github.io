---
import { dicts, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const t = dicts[Astro.props.lang];
const f = t.faq;
// Questions whose answer is a commercial decision still to be made are kept
// in the dictionaries as pending and not shown.
const items = f.items.filter((item) => !item.pending);
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="container faq-grid">
    <h2 id="faq-title" class="display" data-reveal>{f.heading}</h2>
    <div class="faq-list">
      {
        items.map((item) => (
          <details class="faq-item" data-reveal>
            <summary>
              <span>{item.q}</span>
              <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
