---
import { legacyFragments } from "./legacy-fragments";
import {legacyHref} from "../data/routes";
import Base from "../layouts/Base.astro";
import "./radial.css";
import "./liquid-glass.css";
import "./portfolio.css";
import RadialGallery from "./RadialGallery.astro";
import Technologies from "./Technologies.astro";
import Contact from "./PortfolioContact.astro";
import { type Lang } from "../i18n";
import EditorialHeader from "./EditorialHeader.astro";
import EditorialFooter from "./EditorialFooter.astro";
import EditorialScripts from "./EditorialScripts.astro";
import { portfolioCopy } from "../i18n/portfolio";
interface Props {lang:Lang}
const {lang}=Astro.props;
const p=portfolioCopy[lang];

---
<Base lang={lang} editorial>
  <script is:inline slot="head">
    document.documentElement.dataset.cards="glass";
    if(document.documentElement.dataset.motion==="on"){document.documentElement.classList.add("pf-reveal");setTimeout(()=>{if(!window.__pfRevealReady)document.documentElement.classList.remove("pf-reveal")},2500)}
  </script>
    <EditorialHeader lang={lang} />
    <main id="main">
      <section class="pf-hero pf-container" aria-labelledby="intro-title">
        <div>
          <h1 id="intro-title">{p.title[0]}<br /><em>{p.title[1]}</em></h1>
          <p class="pf-signature">Luis Pimentel<span>{p.role}</span></p>
        </div>
        <div class="pf-hero-aside" data-reveal data-reveal-step="1">
          <p>{p.intro}</p>
          <div class="pf-actions">
            <a class="lg lg--clear pf-glass-cta pf-cta-hero" data-lg data-lg-depth="4" data-lg-bezel="10" href="#contact" data-lg-press><span>{p.ctaHero}</span><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12h16m-6-6 6 6-6 6" /></svg></a>
            <a class="pf-text-link" href="#work">{p.projects}</a>
          </div>
        </div>
      </section>
      <div id="projects" class="pf-work pf-container">
        <div class="pf-section-head" data-reveal><h2 id="projects-title">{p.work}</h2><p>{p.workText}</p></div>
        <RadialGallery lang={lang} glass />

      </div>
      <section id="services" class="pf-services" aria-labelledby="services-title">
        <div class="pf-container">
          <div class="pf-section-head" data-reveal><h2 id="services-title">{p.services}</h2><p>{p.servicesText}</p></div>
          <ul class="pf-service-list">
            {p.serviceItems.map((service, index) => <li data-reveal data-reveal-step={index + 1}><h3>{service.title}</h3><p>{service.text}</p><span>{service.detail}</span><a class="pf-text-link pf-service-cta" href={`?${lang === "en" ? "lang=en&" : ""}plan=${service.plan}#contact`} data-plan={service.plan}>{service.cta}<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12h16m-6-6 6 6-6 6" /></svg></a></li>)}
          </ul>
        </div>
      </section>
      <section id="process" class="pf-process pf-container" aria-labelledby="process-title">
        <h2 id="process-title">{p.process.heading}</h2>
        <ol>{p.process.steps.map((step) => <li data-reveal><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
      </section>
      <section id="about" class="pf-about pf-container" aria-labelledby="about-title">
        <div class="pf-about-side" data-reveal="fade">
          <h2 id="about-title">{p.aboutTitle}</h2>
          <dl class="pf-facts">
            {p.facts.map(([term, value]) => <div><dt>{term}</dt><dd>{value}</dd></div>)}
          </dl>
          <div class="pf-about-links">
            <a class="pf-text-link" href="#contact">{p.cv}</a>
          </div>
        </div>
        <div class="pf-bio" data-reveal="fade" data-reveal-step="1"><p class="pf-about-lead">{p.aboutLead}</p></div>
      </section>
      <div class="pf-container pf-tools"><Technologies lang={lang} /></div>
      <div class="pf-contact pf-contact-compact"><Contact lang={lang} /></div>
    </main>
    <EditorialFooter lang={lang} />
    <script>import {initRadial} from "./radial"; initRadial();</script>
    <EditorialScripts />
<noscript><nav class="pf-container" aria-label={lang === "es" ? "Casos de estudio" : "Case studies"}>{legacyFragments.map(id=><p id={id}><a href={legacyHref(lang, id)}>{id} · {lang === "es" ? "Ver documentación" : "Read documentation"}</a></p>)}</nav></noscript>
<script>import "./legacy-links";</script>
</Base>